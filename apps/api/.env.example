# =============================================================================
# NeoBus API — Environment Variables
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env with real values to version control.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_TZ=Asia/Kolkata

# ─── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://neobus:neobus_dev_secret@localhost:5432/neobus_dev

# For e2e tests (a separate database)
DATABASE_URL_TEST=postgresql://neobus:neobus_dev_secret@localhost:5432/neobus_test

# ─── Redis ────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379

# ─── Authentication ───────────────────────────────────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Object Storage (S3 / MinIO) ──────────────────────────────────────────────

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=neobus-uploads-dev
S3_ACCESS_KEY=neobus_minio
S3_SECRET_KEY=neobus_minio_secret
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true

# ─── Firebase Cloud Messaging (Push Notifications) ────────────────────────────

# Paste the Firebase service account JSON as a single-line string (or use a file path)
FCM_SERVICE_ACCOUNT_JSON={}

# ─── WhatsApp Business API ────────────────────────────────────────────────────
# Provider not yet confirmed — see OD-022 in docs/OPEN_DECISIONS.md

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── SMS Gateway ──────────────────────────────────────────────────────────────

SMS_API_KEY=
SMS_SENDER_ID=NEOBUS

# ─── Rate Limiting ────────────────────────────────────────────────────────────

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5
