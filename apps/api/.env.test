# =============================================================================
# NeoBus API — Test Environment Variables
# Used automatically during test runs (Vitest). Targets the dedicated test DB.
# =============================================================================

NODE_ENV=test
PORT=3001
LOG_LEVEL=warn
APP_TZ=Asia/Kolkata

# ─── Database (Dedicated Test Database) ──────────────────────────────────────
DATABASE_URL=postgresql://neobus:neobus_dev_secret@localhost:5432/neobus_test
DATABASE_URL_TEST=postgresql://neobus:neobus_dev_secret@localhost:5432/neobus_test

# ─── Redis (Test DB Index 1) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=test-jwt-secret-test-jwt-secret-test-jwt-secret-test-jwt-secret
JWT_REFRESH_SECRET=test-refresh-secret-test-refresh-secret-test-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Object Storage (MinIO) ───────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=neobus-uploads-test
S3_ACCESS_KEY=neobus_minio
S3_SECRET_KEY=neobus_minio_secret
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true

# ─── Notifications & External Stubs ──────────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON={}
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_API_KEY=
SMS_SENDER_ID=NEOBUS

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=1000
AUTH_THROTTLE_LIMIT=100
