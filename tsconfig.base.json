{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@neo/shared": ["packages/shared/src/index.ts"],
      "@neo/api-client": ["packages/api-client/src/index.ts"],
      "@neo/i18n": ["packages/i18n/src/index.ts"],
      "@neo/mocks": ["packages/mocks/src/index.ts"],
      "@neo/ui": ["packages/ui/src/index.ts"]
    }
  }
}
