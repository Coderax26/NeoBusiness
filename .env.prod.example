# =============================================================================
# NeoBus Production / Pre-Production Environment Variables (Coolify)
# Copy values into Coolify -> Service -> Environment Variables.
# NEVER commit real secrets to GitHub.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=neobus_prod
POSTGRES_USER=neobus_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# Optional override (auto-constructed from POSTGRES_* in docker-compose.prod.yml if omitted)
# DATABASE_URL=postgresql://neobus_app:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/neobus_prod

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT Security (Generate two distinct 64-char hex strings) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_1
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_2
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- CORS & Web ---
# Comma-separated explicit origins (never '*' in production)
ALLOWED_ORIGINS=https://preprod.client-domain.com
# Set COOKIE_SECURE=false ONLY if pre-production runs over plain HTTP (no TLS)
COOKIE_SECURE=true
NEXT_PUBLIC_SHOW_DEMO_PERSONAS=false

# --- Clean Client Workspace Bootstrap (0 demo transactions) ---
BOOTSTRAP_CLIENT=true
BOOTSTRAP_SITE_NAME=Client Main Office & Warehouse
BOOTSTRAP_SITE_TYPE=OFFICE
BOOTSTRAP_SITE_ADDRESS=Client Head Office
BOOTSTRAP_OWNER_NAME=Client Owner
BOOTSTRAP_OWNER_PHONE=+919999999999
BOOTSTRAP_OWNER_PIN=CHANGE_INITIAL_OWNER_PIN

# NEVER enable SEED_ON_STARTUP=true in client environments unless you want fake demo data
SEED_ON_STARTUP=false

# --- Database Pool & Runtime ---
APP_TZ=Asia/Kolkata
LOG_FORMAT=json
LOG_LEVEL=log
DB_POOL_MIN=2
DB_POOL_MAX=25
